# ============================================
# BOT Wall of Weird — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file or PRIVATE_KEY to git.

# Deployer wallet private key (used ONLY by Foundry deployment script, never exposed to frontend)
PRIVATE_KEY=

# Reown (WalletConnect) Project ID for wallet connection (https://cloud.reown.com)
# Note: Use REOWN_ID (not VITE_REOWN_ID or NEXT_PUBLIC_REOWN_ID)
REOWN_ID=

# Deployed BOTWallOfWeird contract address on BOT Chain Testnet (Chain ID: 968)
# Leave empty until deployed; frontend will show a deployment-pending state.
CONTRACT_ADDRESS=

# Optional: Block number where the contract was deployed (speeds up activity log queries)
DEPLOY_BLOCK=0

# BOT Chain Testnet network settings (preconfigured defaults)
BOT_RPC_URL=https://rpc.bohr.life
BOT_CHAIN_ID=968
BOT_EXPLORER_URL=https://scan.bohr.life

